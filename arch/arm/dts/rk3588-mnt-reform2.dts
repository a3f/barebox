/dts-v1/;

#include <arm64/rockchip/rk3588-mnt-reform2.dts>
#include "rk3588.dtsi"
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	barebox,deep-probe;
};

&pcie3x4 {
	/* Does not work in barebox (missing phy driver) */
	status = "disabled";
};

&pcie30phy {
	status = "disabled";
};

&pcie2x1l0 {
	/* Does not work in barebox */
	status = "disabled";
};

&usb_host0_ehci {
	/* Does not work in barebox (missing phy driver) */
	status = "disabled";
};

&usb_host1_ehci {
	/* Does not work in barebox (missing phy driver) */
	status = "disabled";
};
